[Unit]
Description=LibraryOfMyOwn
After=network.target

[Service]
Type=simple
User=archive
Group=archive
WorkingDirectory=/opt/archive/app
Environment=PATH=/opt/archive/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/archive/app/.env
ExecStart=/opt/archive/venv/bin/python -m archive.main
Restart=on-failure
RestartSec=5

# Hardening (compatible with /opt layout)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/archive/data

[Install]
WantedBy=multi-user.target
