# Change the directory paths in this file to /opt/libmyown/data and /opt/libmyown/pdf-scripts
# if you want to self-contain everything in /opt/libmyown

DATA_DIR=data

# Listen address and port
HOST=127.0.0.1
PORT=8000

# optional: change PDF builder modules directory
# PDF_SCRIPTS=pdf-scripts

# optional: Secure session cookies default to on when PUBLIC_URL is https://
# set false to log in over plain http during local development
# HTTPS_ENABLED=true

# optional: if your reverse proxy runs on another machine, list its address here (comma-separated)
# TRUSTED_PROXIES=127.0.0.1

# optional: PDF builder limits
# PDF_BUILD_TIMEOUT=180
# PDF_CACHE_MAX_MB=512

# first run: if ADMIN_PASSWORD is unset, one is generated and printed once to the log.
# If set, it is hashed into secrets.json and you can remove it from here afterwards.
# PUBLIC_URL is only read on first start. Change it later in the Admin panel.

# PUBLIC_URL=https://your.domain
# ADMIN_PASSWORD=
# GIT_PASSWORD=
# GIT_USERNAME=git
