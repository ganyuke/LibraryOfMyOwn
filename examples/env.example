# Change the directory paths in this file to /opt/libmyown/data and /opt/libmyown/pdf-scripts
# if you want to self-contain everything in /opt/libmyown

DATA_DIR=data

# Listen address and port
HOST=127.0.0.1
PORT=8000

# optional: change PDF builder modules directory
# PDF_SCRIPTS=pdf-scripts

# optional: force Secure session cookies when not inferring TLS from the proxy
# HTTPS_ENABLED=true

# optional: override the stories branch (otherwise follows site.json or repo HEAD)
# STORIES_BRANCH=main

# optional: supply secrets for tests or scripted deployments (auto-generated in data/secrets.json on first start if not specified)
# ADMIN_PASSWORD=
# GIT_PASSWORD=
# GIT_USERNAME=git
