# Deployment environment (secrets are auto-generated in data/secrets.json on first start).
DATA_DIR=data
HOST=127.0.0.1
PORT=8000

# Optional: override PDF builder modules directory (default: pdf-scripts/ in the repo)
# PDF_SCRIPTS=pdf-scripts

# Optional: force Secure session cookies when not inferring TLS from the proxy
# HTTPS_ENABLED=true

# Optional: override the stories branch (otherwise follows site.json or repo HEAD)
# STORIES_BRANCH=main

# Optional: bootstrap secrets for automated tests or scripted first deploy only
# ADMIN_PASSWORD=
# GIT_PASSWORD=
# GIT_USERNAME=git
