# Replace your.domain with your domain (to loosen or tighten a rate limit,
# change its events and window)

your.domain {
	@login path /login
	@git path /git/*
	@pdf path_regexp ^/works/.+/pdf/[^/]+$

	handle @login {
		rate_limit {
			zone login_per_ip {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy libmyown:4033
	}

	handle @git {
		rate_limit {
			zone git_per_ip {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy libmyown:4033
	}

	handle @pdf {
		rate_limit {
			zone pdf_per_ip {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy libmyown:4033
	}

	reverse_proxy libmyown:4033
}
