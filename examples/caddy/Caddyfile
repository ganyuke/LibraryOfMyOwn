# Example Caddy config with TLS and per-IP rate limiting.
#
# Requires a custom Caddy build with github.com/mholt/caddy-ratelimit:
#   xcaddy build --with github.com/mholt/caddy-ratelimit
#
# See examples/caddy/README.md for build and install notes.

your.domain {
	@login path /login
	@git path /git/*
	@pdf path_regexp ^/works/.+/pdf/[^/]+$

	handle @login {
		rate_limit {
			zone login_per_ip {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle @git {
		rate_limit {
			zone git_per_ip {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy 127.0.0.1:8000
	}

	# PDF builds are expensive; finished PDFs are cached, so readers rarely hit this.
	handle @pdf {
		rate_limit {
			zone pdf_per_ip {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy 127.0.0.1:8000
	}

	reverse_proxy 127.0.0.1:8000
}
