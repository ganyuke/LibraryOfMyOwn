[Unit]
Description=LibraryOfMyOwn
After=network.target

[Service]
Type=simple
User=libmyown
Group=libmyown
WorkingDirectory=/opt/libmyown/app
Environment=PATH=/opt/libmyown/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/libmyown/app/.env
ExecStart=/opt/libmyown/venv/bin/python -m libmyown.main
Restart=on-failure
RestartSec=5

# --- Hardening -------------------------------------------------------------
# Check the result with systemd-analyze security libmyown

# Block admin rights
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
RestrictSUIDSGID=true

# Make the filesystem read-only except the data directory (if you change
# DATA_DIR in .env, set ReadWritePaths to the same path)
ProtectSystem=strict
ReadWritePaths=/opt/libmyown/data
ProtectHome=true
PrivateTmp=true
UMask=0077

# Allow connections from the local reverse proxy only (if you run Caddy on
# another machine, add its address to IPAddressAllow and to TRUSTED_PROXIES
# in .env)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

# Block access to the kernel, devices and other processes
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true

# Limit system calls to what ordinary services use
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

# Optional: block writable and executable memory, which can break PDF builds
# (if you uncomment it, check that a PDF download still works)
#MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
