<!DOCTYPE html>
<html>
    <h1>History for {{.Entry.Title}}</h1>
    <div>
        <ul>
            {{range .Revisions}}
                <li><a href="/stories/{{$.Entry.Slug}}/r/{{ShortHash .Hash}}">{{ShortHash .Hash}}</a> {{.Author}} {{FormatTimestamp .Date}} {{.OldPath}} - {{.Summary}}</li>
            {{end}}
        </ul>
    </div>
</html>
