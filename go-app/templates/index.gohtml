<!DOCTYPE html>
<html>
    <h1>Stories</h1>
    <ul>
        {{range .}}
        <li>{{.SourcePath}} <a href="/stories/{{.Slug}}">{{.Title}}</a> <p>{{.Author}}</p> <p>{{.WordCount}}</p> <a href="/stories/{{.Slug}}/history">{{FormatSimpleDate .LastUpdated}}</a></li>
        {{end}}
    </ul>
</html>
